#  WATER TANK (irrigation reference point)
# ================================================================
DEF WATER_TANK Solid {
  translation -20 0 1.0
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.1 0.3 0.7 roughness 0.3 metalness 0.5 }
      geometry Cylinder { radius 1.0 height 2.0 }
    }
  ]
  name "water_tank"
  boundingObject Cylinder { radius 1.0 height 2.0 }
  locked TRUE
}

# ================================================================
#  AGROROVER ROBOT — Modified Clearpath Moose
#  Added sensors: Camera, InertialUnit, Accelerometer, Gyro
#  Plus existing: GPS, Compass, DistanceSensor x2
#  Body slot positions: X=forward, Y=left, Z=up (robot local frame)
# ================================================================
Moose {
  translation -6 -20 0
  rotation 0 0 1 1.5708
  name "AgroRover"
  controller "agro_controller"
  bodySlot [

    # ── GPS (NEO-6M equivalent) ──────────────────────────────
    GPS {
      translation 0 0 0.35
      name "gps"
      accuracy 0.5
      noiseCorrelation 0.1
    }

    # ── Compass / Magnetometer ───────────────────────────────
    Compass {
      translation 0 0 0.3
      name "compass"
    }

    # ── IMU — InertialUnit (MPU-6050 equivalent) ─────────────
    InertialUnit {
      translation 0 0 0.25
      name "imu"
      noise 0.005
    }

    # ── Accelerometer ────────────────────────────────────────
    Accelerometer {
      translation 0 0 0.25
      name "accelerometer"
      xAxis TRUE
      yAxis TRUE
      zAxis TRUE
    }

    # ── Gyroscope ────────────────────────────────────────────
    Gyro {
      translation 0 0 0.25
      name "gyro"
      xAxis TRUE
      yAxis TRUE
      zAxis TRUE
    }

    # ── Pi Camera (front-facing, 320x240) ─────────────────────
    Camera {
      translation 0.55 0 0.28
      rotation 0 0 1 0
      name "camera"
      width 320
      height 240
      fieldOfView 1.047
      near 0.1
      far 100
    }

    # ── HC-SR04 FRONT ultrasonic ──────────────────────────────
    DistanceSensor {
      translation 0.65 0 0.1
      rotation 0 0 1 0
      name "us_front"
      lookupTable [
        0    0    0
        0.05 50   0.01
        4.0  4000 0.1
      ]
      type "sonar"
      numberOfRays 5
      aperture 0.26
    }

    # ── HC-SR04 REAR ultrasonic ───────────────────────────────
    DistanceSensor {
      translation -0.65 0 0.1
      rotation 0 0 1 3.14159
      name "us_rear"
      lookupTable [
        0    0    0
        0.05 50   0.01
        4.0  4000 0.1
      ]
      type "sonar"
      numberOfRays 5
      aperture 0.26
    }

    # ── Visual: GPS antenna (yellow box on top) ───────────────
    Solid {
      translation 0.1 0 0.42
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.9 0.85 0.1 emissiveColor 0.3 0.28 0 }
          geometry Box { size 0.06 0.06 0.03 }
        }
      ]
      name "gps_visual"
    }

    # ── Visual: Camera housing (black box front) ──────────────
    Solid {
      translation 0.56 0 0.28
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.05 0.05 0.05 roughness 0.4 }
          geometry Box { size 0.04 0.07 0.05 }
        }
      ]
      name "camera_housing"
    }

    # ── Visual: Electronics box (dark grey top) ───────────────
    Solid {
      translation 0 0 0.3
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.15 0.15 0.15 roughness 0.4 metalness 0.5 }
          geometry Box { size 0.5 0.35 0.08 }
        }
      ]
      name "electronics_box"
    }

    # ── Visual: AgroRover label plate (green) ─────────────────
    Solid {
      translation 0 0 0.39
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.1 0.5 0.1 emissiveColor 0.02 0.1 0.02 }
          geometry Box { size 0.15 0.06 0.02 }
        }
      ]
      name "label_plate"
    }

  ]
}
