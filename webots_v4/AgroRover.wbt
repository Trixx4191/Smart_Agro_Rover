DEF BACKGROUND_PLANE Solid {
  children [
    Shape {
      appearance SandyGround {
        textureTransform TextureTransform {
          rotation 0.2
          scale 200 200
        }
      }
      geometry DEF BG_PLANE Plane {
        size 2000 2000
      }
    }
  ]
  name "background_plane"
  boundingObject USE BG_PLANE
  locked TRUE
}

Moose {
  translation -7 0 6
  rotation 0 0 1 -1.5708
  name "AgroRover"
  controller "agro_controller"
  bodySlot [
    GPS {
      name "gps"
    }
    Compass {
      name "compass"
    }
    DistanceSensor {
      translation 0.6 0 0
      rotation 0 0 1 0
      name "us_front"
      lookupTable [ 0 0 0  0.1 100 0.02  3 3000 0.1 ]
      type "sonar"
      numberOfRays 5
      aperture 0.3
    }
    DistanceSensor {
      translation -0.6 0 0
      rotation 0 0 1 3.14159
      name "us_rear"
      lookupTable [ 0 0 0  0.1 100 0.02  3 3000 0.1 ]
      type "sonar"
      numberOfRays 5
      aperture 0.3
    }
  ]
}
