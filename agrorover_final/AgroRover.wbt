WorldInfo {
  info [
    "AgroRover - Autonomous Farm Rover Simulation"
    "Modified Clearpath Moose chassis"
    "Sensors: GPS, Compass, IMU, Camera, 2x Ultrasonic"
    "Mission: Boustrophedon soil survey across 5 crop rows"
    "Mirrors real hardware: Arduino Nano + Raspberry Pi 4"
  ]
  title "AgroRover Farm Simulation"
  CFM 0.0003
  ERP 0.4
  basicTimeStep 16
  FPS 250
  defaultDamping Damping {
  }
  lineScale 0.2
  contactProperties [
    ContactProperties {
      material1 "wheel"
      material2 "moose wheel"
      coulombFriction [
        4
      ]
      softCFM 1e-05
      bumpSound ""
      rollSound ""
      slideSound ""
    }
  ]
}
